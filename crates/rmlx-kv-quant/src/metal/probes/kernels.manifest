# Compile-probe manifest — drives `make check-metal-compiles`.
#
# The .metal files under ../ are kernel *bodies*: MLX supplies the function
# signature and buffer declarations at dispatch, so a body is not a standalone
# Metal translation unit. To syntax-check one, the gate assembles
#
#     <metal_stdlib preamble> + <header> + kernel probe { <buffer aliases> <body> }
#
# and compiles that. This file supplies, per body, the header to prepend and the
# buffer names the body expects (with their dispatch dtype). Buffer names and
# order mirror the `MetalKernel::new(.., input_names, output_names)` call sites;
# dtypes mirror the arrays those sites pass / `add_output_shape` declares.
#
# Format:  <body.metal> | <header or -> | <name:type,...> | [NAME=VALUE,...]
#   type: u = uint buffer, i = int buffer, f = float buffer, b = bfloat buffer
#
# The optional fourth field emits `#define NAME VALUE` immediately ahead of the
# body. It supplies the values MLX injects at dispatch that are neither buffers
# nor part of a header: template dtypes (`OutT`), template ints, and scalar 0-D
# inputs that appear in the body as a numeric literal. Values are
# representative — the probe checks that the body parses and resolves, not that a
# particular shape is the production one.
#
# Headers ending in `.hdr.metal` live in this directory and are snapshots of the
# Rust-generated runtime headers (codebooks / rotation constants), captured for
# the probe only — production still builds them at dispatch. Regenerate them if
# a header builder changes; see README.md here.
#
# Every `.metal` file in the parent directory must appear here, as a body or as
# a `../`-prefixed header. The gate fails on one that does not: a body missing
# from this file is not checked by anything, which is the failure mode the gate
# exists to prevent.

# One flash-decode pass-1 body serves both iso bit widths — the unpack width
# arrives via the header (IF_BITS / IF_MASK), so each header gets its own probe
# line over the same body.
iso_flash_decode_p1.metal | iso_flash_decode_p1_b3.hdr.metal | query:f,codes:u,scales:b,norms:b,v_flat:f,mask_flat:f,scale_arr:f,dims:u,partial_o:f,tile_max:f,tile_sum_exp:f
iso_flash_decode_p1.metal | iso_flash_decode_p1_b4.hdr.metal | query:f,codes:u,scales:b,norms:b,v_flat:f,mask_flat:f,scale_arr:f,dims:u,partial_o:f,tile_max:f,tile_sum_exp:f
# The all-quant sibling: same two headers (both axes of a symmetric iso codec
# share one bit width, so IF_BITS covers the K and the V unpack), and it calls
# the header's `if_decode_k_lane` for both. V arrives as its own packed ring
# instead of a bf16 mirror, hence v_codes/v_scales/v_norms in place of v_flat.
iso_flash_decode_symv_p1.metal | iso_flash_decode_p1_b3.hdr.metal | query:f,k_codes:u,k_scales:b,k_norms:b,v_codes:u,v_scales:b,v_norms:b,mask_flat:f,scale_arr:f,dims:u,partial_o:f,tile_max:f,tile_sum_exp:f
iso_flash_decode_symv_p1.metal | iso_flash_decode_p1_b4.hdr.metal | query:f,k_codes:u,k_scales:b,k_norms:b,v_codes:u,v_scales:b,v_norms:b,mask_flat:f,scale_arr:f,dims:u,partial_o:f,tile_max:f,tile_sum_exp:f
isoquant_quantize_iso3.metal | isoquant_iso3.hdr.metal | inp:f,n_groups:u,codes_out:u,scales_out:b,norms_out:b
isoquant_dequantize_iso3.metal | isoquant_iso3.hdr.metal | codes_in:u,scales_in:b,norms_in:b,n_groups:u,out:f
isoquant_quantize_iso4.metal | isoquant_iso4.hdr.metal | inp:f,n_groups:u,codes_out:u,scales_out:b,norms_out:b
isoquant_dequantize_iso4.metal | isoquant_iso4.hdr.metal | codes_in:u,scales_in:b,norms_in:b,n_groups:u,out:f
k8vturbo3_quantize.metal | ../k8vturbo3_header.metal | inp:f,codes:u,scales:f
k8vturbo3_dequantize.metal | ../k8vturbo3_header.metal | codes:u,scales:f,out:f | OutT=float
planar_flash_decode_p1.metal | planar_flash_decode_p1.hdr.metal | query:f,k_codes:u,k_scales:f,k_rot32:u,v_flat:f,mask_flat:f,scale_arr:f,dims:u,partial_o:f,tile_max:f,tile_sum_exp:f
# Codec-agnostic flash-decode pass-2 LSE merge; shared by the planar, rotor and
# iso flash-decode dispatchers (each registers its own kernel name over this
# body).
flash_decode_merge_p2.metal | - | partial_o:f,tile_max:f,tile_sum_exp:f,dims_p2:u,dst:f
planar_fused_qk_b3.metal | planar_fused_qk_b3.hdr.metal | query:f,codes:u,scales:f,rot32:u,scale_arr:f,dims:u,out:f
planar_fused_qk_b4.metal | planar_fused_qk_b4.hdr.metal | query:f,codes:u,scales:f,rot32:u,scale_arr:f,dims:u,out:f
planarquant_quantize.metal | planarquant_v4.hdr.metal | inp:f,codes:u,scales:f,rot32:u
planarquant_dequantize.metal | planarquant_v4.hdr.metal | codes:u,scales:f,rot32:u,out:f
planarquant_quantize_v3.metal | planarquant_v3.hdr.metal | inp:f,codes:u,scales:f,rot32:u
planarquant_dequantize_v3.metal | planarquant_v3.hdr.metal | codes:u,scales:f,rot32:u,out:f
q8_fused_qk.metal | - | query:f,codes:u,scales:f,mask:f,scale_arr:f,dims:u,out:f
q8_quantize.metal | - | inp:f,codes:u,scales:f
q8_dequantize.metal | - | codes:u,scales:f,out:f | OutT=float
# NOT a codec kernel: the positive control for the shader-validation gate. It
# stores out of bounds on purpose, which the Metal compiler accepts — only the
# runtime validator catches it — so probing it checks syntax exactly like any
# other body.
shader_validation_canary.metal | - | inp:f,out:f
# No rot_k_fwht_quantize_d32: a 32-element row is shorter than the affine group size
# (64), so the kernel's per-group SMEM would be a zero-length array — MSL that does not
# compile. That shape is rejected in Rust (build_fwht_quantize_body returns Err) and the
# caller falls back to the matmul path, so no d32 quantize kernel exists to probe.
# Rotation has no group structure, so rot_k_fwht_rotate_d32 is real and is probed below.
rot_k_fwht_quantize_d64.metal | rot_k.hdr.metal | inp:f,out_codes:u,out_scales:f,out_biases:f
rot_k_fwht_quantize_d128.metal | rot_k.hdr.metal | inp:f,out_codes:u,out_scales:f,out_biases:f
rot_k_fwht_quantize_d256.metal | rot_k.hdr.metal | inp:f,out_codes:u,out_scales:f,out_biases:f
rot_k_fwht_quantize_d512.metal | rot_k.hdr.metal | inp:f,out_codes:u,out_scales:f,out_biases:f
rot_k_fwht_rotate_d32.metal | rot_k.hdr.metal | inp:f,out:f
rot_k_fwht_rotate_d64.metal | rot_k.hdr.metal | inp:f,out:f
rot_k_fwht_rotate_d128.metal | rot_k.hdr.metal | inp:f,out:f
rot_k_fwht_rotate_d256.metal | rot_k.hdr.metal | inp:f,out:f
rot_k_fwht_rotate_d512.metal | rot_k.hdr.metal | inp:f,out:f
# One flash-decode pass-1 body serves both rotor bit widths — the unpack width
# arrives via the header (RF_BITS / RF_MASK), so each header gets its own probe
# line over the same body.
rotor_flash_decode_p1.metal | rotor_flash_decode_p1_b3.hdr.metal | query:f,codes:u,scales:b,norms:b,rotors:f,v_flat:f,mask_flat:f,scale_arr:f,dims:u,partial_o:f,tile_max:f,tile_sum_exp:f
rotor_flash_decode_p1.metal | rotor_flash_decode_p1_b4.hdr.metal | query:f,codes:u,scales:b,norms:b,rotors:f,v_flat:f,mask_flat:f,scale_arr:f,dims:u,partial_o:f,tile_max:f,tile_sum_exp:f
# The all-quant sibling: same two headers (both axes of a symmetric rotor codec
# share one bit width, so RF_BITS covers the K and the V unpack), and it calls
# the header's `rf_decode_k_group` for both. V arrives as its own packed ring
# instead of a bf16 mirror, hence v_codes/v_scales/v_norms/v_rotors in place of
# v_flat.
rotor_flash_decode_symv_p1.metal | rotor_flash_decode_p1_b3.hdr.metal | query:f,k_codes:u,k_scales:b,k_norms:b,k_rotors:f,v_codes:u,v_scales:b,v_norms:b,v_rotors:f,mask_flat:f,scale_arr:f,dims:u,partial_o:f,tile_max:f,tile_sum_exp:f
rotor_flash_decode_symv_p1.metal | rotor_flash_decode_p1_b4.hdr.metal | query:f,k_codes:u,k_scales:b,k_norms:b,k_rotors:f,v_codes:u,v_scales:b,v_norms:b,v_rotors:f,mask_flat:f,scale_arr:f,dims:u,partial_o:f,tile_max:f,tile_sum_exp:f
# One fused-QK body serves both rotor bit widths — the unpack width arrives via
# the header (RF_BITS / RF_MASK), so each header gets its own probe line over the
# same body.
rotor_fused_qk.metal | rotor_fused_qk_b3.hdr.metal | query:f,codes:u,scales:b,norms:b,rotors:f,mask:f,scale_arr:f,dims:u,out:f
rotor_fused_qk.metal | rotor_fused_qk_b4.hdr.metal | query:f,codes:u,scales:b,norms:b,rotors:f,mask:f,scale_arr:f,dims:u,out:f
rotorquant_quantize_rotor3.metal | rotorquant_rotor3.hdr.metal | inp:f,rotors_in:f,n_groups:u,head_dim:u,codes_out:u,scales_out:b,norms_out:b
rotorquant_dequantize_rotor3.metal | rotorquant_rotor3.hdr.metal | codes_in:u,scales_in:b,norms_in:b,rotors_in:f,n_groups:u,head_dim:u,out:f
rotorquant_quantize_rotor4.metal | rotorquant_rotor4.hdr.metal | inp:f,rotors_in:f,n_groups:u,head_dim:u,codes_out:u,scales_out:b,norms_out:b
rotorquant_dequantize_rotor4.metal | rotorquant_rotor4.hdr.metal | codes_in:u,scales_in:b,norms_in:b,rotors_in:f,n_groups:u,head_dim:u,out:f
tcq_v_quantize.metal | ../tcq_v_header.metal | inp:f,codes:u,scales:f
turbo2_v_quantize.metal | ../turbo2_v_header.metal | inp:f,codes:u,scales:f
turbo2_v_dequantize.metal | ../turbo2_v_header.metal | codes:u,scales:f,out:f | OutT=float
turbo_flash_p1.metal | ../turbo_flash_header.metal | q_flat:f,k_codes:u,k_scales:f,v_codes:u,v_scales:f,mask_flat:f,params_p1:u,partial_out:f,partial_ms:f
turbo_flash_p2.metal | ../turbo_flash_header.metal | partial_out:f,partial_ms:f,params_p2:u,dst:f
turbo_k3_fused_qk.metal | ../turbo_k3_fused_qk_header.metal | query:f,codes:u,scales:f,mask:f,scale_arr:f,dims:u,out:f
turbo_k4_fused_qk.metal | ../turbo_k4_fused_qk_header.metal | query:f,codes:u,scales:f,mask:f,scale_arr:f,dims:u,out:f
turboquant_quantize.metal | ../turboquant_header.metal | inp:f,codes:u,scales:f
turboquant_dequantize.metal | ../turboquant_header.metal | codes:u,scales:f,out:f | OutT=float
turboquant_quantize_cb_buf.metal | - | inp:f,cb:f,codes:u,scales:f
turboquant_dequantize_cb_buf.metal | - | codes:u,scales:f,cb:f,out:f | OutT=float
sparse_attn_phase1_score.metal | sparse_attn_phase1_score.hdr.metal | query:f,k_codes:u,k_scales:f,k_rot32:u,scale_arr:f,dims:u,tile_top_scores:f,tile_top_indices:u,all_scores:f
sparse_attn_phase2_attend.metal | sparse_attn_phase2_attend.hdr.metal | query:f,k_codes:u,k_scales:f,k_rot32:u,v_flat:f,all_scores:f,head_threshold:f,scale_arr:f,dims:u,partial_o:f,tile_lse:f
sparse_attn_phase2_merge.metal | - | partial_o:f,tile_lse:f,dims_p2:u,dst:f
